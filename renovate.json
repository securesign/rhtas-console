{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>securesign/renovate-config//org-inherited-config.json"
  ],
  "enabledManagers": ["dockerfile", "gomod", "tekton", "custom.regex"],
  "ignorePaths": [
    "Dockerfile{,}",
    ".devcontainer/**",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "description": "Disable GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    }
  ]
}
